# Copy to .env and fill in real values before starting the admin panel.
# NEVER commit the real .env file — it's already in .gitignore.

ADMIN_USER=admin
ADMIN_PASSWORD=change_this_now

# Ollama server the admin panel forwards chat requests to (usually local on the same VPS)
OLLAMA_HOST=http://localhost:11434

# Which model to chat with by default (must already be pulled/created in Ollama)
MODEL_NAME=firelam-1.5

# Your domain, once DNS + nginx + SSL are set up (see deploy/README.md)
DOMAIN=ai.yourdomain.com
