[Unit]
Description=FireLam Admin Panel + Chat API
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/firelam/admin_panel
EnvironmentFile=/opt/firelam/admin_panel/.env
ExecStart=/opt/firelam/admin_panel/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

# Basic hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/firelam/admin_panel/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
